{
  "name": "ritesh-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "npm run build -w riteshjs",
    "lint": "eslint . && tsc --noEmit -p tsconfig.json && npm run typecheck -w riteshjs",
    "test": "npm test -w riteshjs",
    "check:package": "npm run check:package -w riteshjs",
    "changeset": "changeset",
    "sync:protocol": "node scripts/sync-protocol.mjs",
    "e2e": "playwright test",
    "demo:record": "node scripts/record-demo.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.4",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0"
  }
}
